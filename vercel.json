{
 "headers": [
  {
   "source": "/sw.js",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/index.html",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/shell.txt",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    },
    {
     "key": "Cache-Control",
     "value": "no-cache"
    }
   ]
  },
  {
   "source": "/g/(.*)",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/art/(.*)",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    }
   ]
  },
  {
   "source": "/words/(.*)",
   "headers": [
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=86400"
    }
   ]
  }
 ]
}